{
  "description": "SSH Manager hooks. /ssh-on [target] and /ssh-off toggle ssh-mode; when on, SessionStart/PostCompact/SubagentStart inject a reminder to use the SSH Manager MCP.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reminder.mjs\"",
            "timeout": 5,
            "statusMessage": "Handling ssh-mode command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reminder.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking ssh-mode reminder"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reminder.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reminder.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
