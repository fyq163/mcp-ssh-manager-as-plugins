{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${PLUGIN_ROOT}\" && test -d node_modules || npm install --omit=dev",
            "statusMessage": "Installing mcp-ssh-manager dependencies"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/prompt_mcp_ssh.py",
            "statusMessage": "Reminding to use mcp-ssh-manager"
          }
        ]
      }
    ]
  }
}
